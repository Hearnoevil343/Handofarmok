{
  // The app in src/. Type checked here; Vite does the actual build.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // import shortcuts; keep in step with SOURCE_FOLDERS in vite.config.ts
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@df/*": ["./src/df/*"],
      "@engine/*": ["./src/engine/*"],
      "@formats/*": ["./src/formats/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@map/*": ["./src/map/*"],
      "@store/*": ["./src/store/*"],
      "@styles/*": ["./src/styles/*"],
      "@theme/*": ["./src/theme/*"],
      "@world/*": ["./src/world/*"],
      "#types": ["./src/types.ts"]
    }
  },
  "include": ["src"]
}
